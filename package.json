{
  "name": "gsm-shield-av",
  "version": "1.0.0",
  "description": "GSM Shield AV — Windows antivirus purpose-built for GSM phone repair technicians",
  "private": true,
  "workspaces": [
    "renderer"
  ],
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"cross-env NODE_ENV=development vite\" \"cross-env NODE_ENV=development electron .\"",
    "dev:renderer": "vite --config renderer/vite.config.js",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build --config renderer/vite.config.js",
    "build:electron": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir",
    "build:full": "node scripts/build.js",
    "build:stage1": "node scripts/build.js --stage1",
    "build:stage2": "node scripts/build.js --stage2",
    "build:stage3": "node scripts/build.js --stage3",
    "start": "electron .",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "chokidar": "3.6.0",
    "node-machine-id": "1.1.12",
    "node-windows": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "28.3.3",
    "electron-builder": "24.13.3",
    "fast-check": "^3.22.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "supertest": "^7.0.0",
    "vite": "5.4.10"
  },
  "build": {
    "extends": "./electron-builder.yml"
  }
}
